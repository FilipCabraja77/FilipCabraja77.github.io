# Poslovni centar Fenix: Apache / LiteSpeed. CSP hashevi upisuju se pri buildu (scripts/postbuild.mjs).
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html
# 403 namjerno prikazuje stranicu 404 (ne otkriva se što postoji), status ostaje 403
ErrorDocument 403 /404.html
ErrorDocument 500 /500.html
ErrorDocument 503 /503.html
<If "%{REQUEST_URI} =~ m#^/en/#">
  ErrorDocument 404 /en/404.html
  ErrorDocument 403 /en/404.html
  ErrorDocument 500 /en/500.html
  ErrorDocument 503 /en/503.html
</If>
<If "%{REQUEST_URI} =~ m#^/de/#">
  ErrorDocument 404 /de/404.html
  ErrorDocument 403 /de/404.html
  ErrorDocument 500 /de/500.html
  ErrorDocument 503 /de/503.html
</If>
<If "%{REQUEST_URI} =~ m#^/bg/#">
  ErrorDocument 404 /bg/404.html
  ErrorDocument 403 /bg/404.html
  ErrorDocument 500 /bg/500.html
  ErrorDocument 503 /bg/503.html
</If>
AddDefaultCharset utf-8
AddType application/manifest+json .webmanifest

RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
# trajna preusmjeravanja sa stare stranice (src/data/redirects.json)
RewriteRule ^knjigovodstvo/?$ /usluge/knjigovodstvo/ [R=301,L]
RewriteRule ^prevodenje/?$ /usluge/prevodenje/ [R=301,L]
RewriteRule ^poslovno-savjetovanje/?$ /usluge/racunovodstveno-savjetovanje/ [R=301,L]
RewriteRule ^zastupanje-inozemnih-tvrtki/?$ /usluge/strane-tvrtke/ [R=301,L]
RewriteRule ^digitalni-marketing/?$ /usluge/ [R=301,L]
RewriteRule ^book/tajna-novca/?$ /tajna-novca/ [R=301,L]
RewriteRule ^blog/?$ /savjeti/ [R=301,L]
RewriteRule ^category/ /savjeti/ [R=301,L]
RewriteRule ^naslov-1/?$ /fiskalizacija-2-0-prvo-eizvjestavanje/ [R=301,L]
RewriteRule ^izjava-o-povjerljivosti/?$ /zastita-privatnosti/ [R=301,L]
RewriteRule ^politika-kolacica-cookies/?$ /politika-kolacica/ [R=301,L]
RewriteRule ^knjige/?$ /tajna-novca/ [R=301,L]
RewriteRule ^newsletter/?$ /porezni-kalendar/ [R=301,L]
RewriteRule ^488-2/?$ / [R=301,L]
RewriteRule ^tag/ /savjeti/ [R=301,L]
RewriteRule ^en/blog/?$ /en/ [R=301,L]
RewriteRule ^de/blog/?$ /de/ [R=301,L]
RewriteRule ^en/moj-prvi-clanak/?$ /en/ [R=301,L]
RewriteRule ^de/moj-prvi-clanak/?$ /de/ [R=301,L]
RewriteRule ^en/tag/ /en/ [R=301,L]
RewriteRule ^de/tag/ /de/ [R=301,L]
RewriteRule ^en/category/ /en/ [R=301,L]
RewriteRule ^de/category/ /de/ [R=301,L]
RewriteRule ^bg/363-2/?$ /bg/ [R=301,L]

